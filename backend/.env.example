# Copy this file to backend/.env for local development.
# Placeholders only. Never commit a real .env file.

# Runtime environment: development | test | production
APP_ENV=development

# PostgreSQL connection string (SQLAlchemy URL using the psycopg 3 driver).
# Plain postgresql:// URLs (for example from Supabase) are converted automatically.
# Local example without a password: postgresql+psycopg://YOUR_MAC_USERNAME@localhost:5432/portfolio_intelligence
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/portfolio_intelligence

# "session" (default): local PostgreSQL, migrations and the market-data sync.
# "transaction": a transaction-mode pooler such as Supabase port 6543, for the deployed API.
# DATABASE_POOL_MODE=session

# Browser origins allowed to call the API directly, as a JSON list. Defaults to localhost in
# development and test, and to none in production, where origins must be explicit https://.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Write endpoints (create portfolios, add or delete holdings, CSV). Default: enabled, except
# with APP_ENV=production, where the public demo is read-only.
# ENABLE_WRITE_API=true

# --- Market data (M3A) ---------------------------------------------------------
# Indian API key for NSE end-of-day prices. Backend only: never expose it to the
# frontend, never commit it. Leave empty to run without market data.
INDIAN_API_KEY=

# Optional overrides (defaults shown).
# MARKET_DATA_MONTHLY_REQUEST_BUDGET=450
# MARKET_DATA_BACKFILL_PERIOD=1yr
# NSE trading calendar used by the price-freshness rules, as JSON lists of ISO dates.
# Defaults: NSE's published 2026 calendar (app/market_data/nse_calendar.py). Setting a
# variable replaces its default list.
# NSE_TRADING_HOLIDAYS=["2026-01-15","2026-01-26"]
# NSE_SPECIAL_TRADING_SESSIONS=["2026-02-01"]

# Optional: enables the database tests in `uv run pytest`.
# Must be a separate database whose name ends in _test; the tests reset its schema.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/portfolio_intelligence_test
